# MongoDB Atlas connection string from the hackathon sandbox cluster
MONGODB_URI=
MONGODB_DB_NAME=ap_harness

# Atlas model API key (Voyage embeddings/reranking at ai.mongodb.com). Powers semantic memory over past cases.
MONGODB_MODEL_API_KEY=
EMBEDDING_MODEL=voyage-4-lite

# LLM provider key. Mastra's model router reads OPENAI_API_KEY for openai/* ids
# (or ANTHROPIC_API_KEY for anthropic/* ids). The Atlas model API has no chat models.
OPENAI_API_KEY=

# Worker processes invoices (cheap, runs hundreds of times). Reflector rewrites the harness (smart, runs once per generation).
WORKER_MODEL=openai/gpt-6-luna
REFLECTOR_MODEL=openai/gpt-6-luna
